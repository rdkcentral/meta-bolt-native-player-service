{
  "id": "com.rdkcentral.nativeplayer",
  "version": "0.1.0",
  "name": "nativeplayer",
  "packageType": "service",
  "entryPoint": "/usr/bin/nativeplayer",
  "dependencies": {
    "com.rdkcentral.base": "0.3.1"
  },
  "permissions": [
	  "urn:rdk:permission:firebolt",
	  "urn:rdk:permission:internet"
  ],
  "configuration": {
	  "urn:rdk:config:network": [
	  {
        "name": "com.rdkcentral.nativeplayer",
        "port": 10101,
        "protocol": "tcp",
        "type": "exported"
      }
	  ]
  }
}
